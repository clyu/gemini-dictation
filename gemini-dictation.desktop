[Desktop Entry]
Type=Application
Name=Gemini Dictation
Name[zh_TW]=Gemini 語音輸入
GenericName=Voice Dictation
GenericName[zh_TW]=語音輸入
Comment=Push-to-talk dictation, transcribed by the Gemini Live API
